# WhatsApp provider: meta (Cloud API direct) or d360 (360dialog, coexistence pilot). docs/360dialog.md
WA_PROVIDER=meta
# --- meta (Meta app → WhatsApp → API Setup)
WA_TOKEN=            # meta: permanent system-user token · d360: the number's 360dialog API key
WA_PHONE_NUMBER_ID=  # meta: phone number ID of the kitchen's business number (not the number itself)
WA_APP_SECRET=       # meta: App settings → Basic → App secret (verifies webhook signatures)
WA_VERIFY_TOKEN=     # meta: any random string; paste the same value in the webhook config
# WA_GRAPH_VERSION=v23.0
# WA_WABA_ID=        # meta: WhatsApp Business Account id, for pnpm wa:templates:sync / wa:check
# --- d360 (360dialog Hub → number → API key)
# WA_PROVIDER=d360
# WA_TOKEN=<360dialog API key>   # generating a new key revokes the old one: re-run pnpm wa:webhook:set
# WA_WEBHOOK_SECRET=            # long random string; 360dialog sends it back as X-Preppr-Secret
# WA_API_URL=https://waba-v2.360dialog.io          # default; sandbox: https://waba-sandbox.360dialog.io
WA_DRY_RUN=0         # 1 = print outbound messages instead of calling Meta
BOT_NUMBER=+12015550199   # the kitchen's WhatsApp Business number (shared with the app), used in the order link

# Coexistence: bot on the owner's existing WhatsApp Business number (docs/coexistence-setup.md)
WA_COEXISTENCE=1                # menu push instead of broadcast lists; bot pauses when the owner replies in the app
# UNKNOWN_SENDERS=order_only    # default with coexistence: unknown numbers get no reply unless they ask to order
# MENU_TEMPLATE=daily_order_open   # approved utility template for customers outside the 24 h window
# MENU_TEMPLATE_LANG=en_US
# Another BSP proxy under WA_PROVIDER=meta (full messages URL + API-key header):
# WA_API_URL=https://bsp.example/messages
# WA_AUTH_HEADER=X-Api-Key

# Owner menu assistant (docs/owner-assistant.md): only OWNER_NUMBERS get answers, customers order via WhatsForm.
# OWNER_ONLY=1                  # everyone else is recorded and ignored (no reply, no model call)
# ORDER_CHANNEL=whatsform       # bot (default) | whatsform: Publish gives form lines + broadcast with the form link; no cutoff summary

# Rollout (docs/runbook.md): shadow = read and record, send customers nothing; assist = only
# confident order summaries go out, the rest waits for the owner (REVIEW); live = normal.
# The owner's BOT OFF / BOT ON overrides this for all customers.
BOT_MODE=shadow
# ASSIST_MIN_CONFIDENCE=0.9

# Order parser model. Default: Claude.
LLM_PROVIDER=anthropic          # anthropic | openrouter | huggingface | openai (any OpenAI-compatible API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# For openrouter / huggingface / openai, instead:
# LLM_API_KEY=                  # OpenRouter key, or Hugging Face token
# LLM_MODEL=                    # e.g. a ":free" model id from openrouter.ai/models, or an instruct model from huggingface.co/inference/models
# LLM_BASE_URL=                 # only for openai (e.g. http://localhost:11434/v1 for Ollama)

# DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # unset = in-memory (dev only)

OWNER_NUMBERS=+12015550100      # the owner's personal WhatsApp, comma-separated, E.164; never BOT_NUMBER
TZ=America/New_York
CUTOFF_TIME=10:30               # default when the MENU message has no cutoff
AREAS=Journal Square,Newport,Heights
PAYMENT_INSTRUCTIONS=Pay by Zelle to 201-555-0100 or Venmo @tiffin-kitchen
KITCHEN_NAME=Tiffin Kitchen
JOB_SECRET=                     # random string; the cron Worker sends it as Authorization: Bearer (or X-Job-Secret)

# Monitoring (see docs/monitoring.md)
# SENTRY_DSN=                   # unset = errors only go to logs
# SENTRY_ENVIRONMENT=production
MENU_EXPECTED_BY=09:00          # alert if no menu is published by then on a kitchen day
KITCHEN_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
# OPERATOR_NUMBERS=+1...        # whoever runs the service: ops alerts on WhatsApp (when their 24 h window is open) besides Sentry; add the owner too if they want them
# WATCHDOG_NO_INBOUND_MIN=120   # alert when no webhook arrives for this long while ordering is open
# SEND_FAIL_THRESHOLD=3         # alert when more sends than this fail in an hour

# Chat viewer: owner sends CHATS and gets a 12-hour link (both unset = off)
# PUBLIC_URL=https://wa.example.com   # this service's public address (tunnel hostname; no _ or :port for 360dialog)
# ADMIN_SECRET=                             # long random string; changing it logs everyone out

# Google Sheet export (optional; both unset = off). See docs/google-sheet-setup.md
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/sheets-key.json   # path to the key file, or the key JSON itself (e.g. from Secret Manager)
# SHEET_ID=                     # the long id in the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit

# Staging kitchen (docs/deploy.md "Staging"): copy this file to .env.staging and run any script or compose
# with ENV_FILE=.env.staging; it then reads that file instead of .env.

# Pilot on one machine (docs/pilot-cloudflare.md): Cloudflare named tunnel token, read by deploy/pilot/docker-compose.yml
# TUNNEL_TOKEN=

# Nightly pg_dump to Cloudflare R2 (backup service in deploy/pilot/docker-compose.prod.yml)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=preppr-backups
# BACKUP_AT=03:00               # local time (TZ)
# BACKUP_KEEP_DAYS=14
