# WhatsApp Cloud API (Meta app → WhatsApp → API Setup)
WA_TOKEN=            # permanent system-user token
WA_PHONE_NUMBER_ID=  # the bot number's phone number ID (not the number itself)
WA_APP_SECRET=       # App settings → Basic → App secret (verifies webhook signatures)
WA_VERIFY_TOKEN=     # any random string; paste the same value in the webhook config
WA_DRY_RUN=0         # 1 = print outbound messages instead of calling Meta
BOT_NUMBER=+12015550199   # the bot's own number, used in the wa.me "tap to order" link

# Order parser model. Default: Claude.
LLM_PROVIDER=anthropic          # anthropic | openrouter | huggingface | openai (any OpenAI-compatible API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# For openrouter / huggingface / openai, instead:
# LLM_API_KEY=                  # OpenRouter key, or Hugging Face token
# LLM_MODEL=                    # e.g. a ":free" model id from openrouter.ai/models
# LLM_BASE_URL=                 # only for openai (e.g. http://localhost:11434/v1 for Ollama)

# DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # unset = in-memory (dev only)

OWNER_NUMBERS=+12015550100      # comma-separated, E.164
TZ=America/New_York
CUTOFF_TIME=10:30               # default when the MENU message has no cutoff
AREAS=Journal Square,Newport,Heights
PAYMENT_INSTRUCTIONS=Pay by Zelle to 201-555-0100 or Venmo @tiffin-kitchen
KITCHEN_NAME=Tiffin Kitchen
JOB_SECRET=                     # random string; Cloud Scheduler sends it as X-Job-Secret

# Monitoring (see docs/monitoring.md)
# SENTRY_DSN=                   # unset = errors only go to logs
# SENTRY_ENVIRONMENT=production
MENU_EXPECTED_BY=09:00          # alert if no menu is published by then on a kitchen day
KITCHEN_DAYS=Mon,Tue,Wed,Thu,Fri,Sat

# Chat viewer: owner sends CHATS and gets a 12-hour link (both unset = off)
# PUBLIC_URL=https://preppr-xxxx.a.run.app   # this service's public address
# ADMIN_SECRET=                             # long random string; changing it logs everyone out

# Google Sheet export (optional; both unset = off). See docs/google-sheet-setup.md
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/sheets-key.json   # path to the key file, or the key JSON itself (e.g. from Secret Manager)
# SHEET_ID=                     # the long id in the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
