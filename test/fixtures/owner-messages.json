  "cases": [
    { "message": "today dal paneer aur roti", "expect": { "action": "set_menu", "dishes": [1, 2, 3] } },
    { "message": "aaj ka menu chole rice roti", "expect": { "action": "set_menu", "dishes": [2, 4, 5] } },
    { "message": "kal ke liye 1 3 5", "expect": { "action": "set_menu", "dishes": [1, 3, 5], "day": "tomorrow" } },
    { "message": "tomorrow only big dal and roti, orders till 11", "expect": { "action": "set_menu", "dishes": [1, 2], "sizesOf": { "1": ["16oz"] }, "cutoff": true } },
    { "message": "today dal, chole and biryani", "expect": { "action": "set_menu", "dishes": [1, 5], "unknown": true } },
    { "message": "same as saturday but no rice", "expect": { "action": "copy_menu", "remove": [4] } },
    { "message": "wahi menu jo pichli baar tha, plus gulab jamun", "expect": { "action": "copy_menu", "add": [6] } },
    { "message": "same as last time", "expect": { "action": "copy_menu" } },
    { "message": "add gulab jamun to the menu", "open": true, "expect": { "action": "edit_menu", "add": [6] } },
    { "message": "remove roti", "open": true, "expect": { "action": "edit_menu", "remove": [2] } },
    { "message": "no small paneer today", "open": true, "expect": { "action": "edit_menu", "remove": [3], "sizesOf": { "3": ["S"] } } },
    { "message": "make cutoff 10:45", "open": true, "expect": { "actionIn": ["set_cutoff", "edit_menu"], "cutoff": true } },
    { "message": "add samosa 2 each", "expect": { "action": "add_products", "prices": { "Samosa": [200] } } },
    { "message": "new dish aloo gobi small 6 large 10", "expect": { "action": "add_products", "prices": { "Aloo Gobi": [600, 1000] } } },
    { "message": "dal 16oz is 11 now", "expect": { "action": "edit_product", "ns": [1], "prices": { "*": [600, 1100] } } },
    { "message": "paneer large ka price 13 kar do", "expect": { "action": "edit_product", "ns": [3], "prices": { "*": [500, 800, 1300] } } },
    { "message": "we don't make chole any more, take it off my list", "expect": { "action": "remove_product", "ns": [5] } },
    { "message": "show me my dishes", "expect": { "action": "show_products" } },
    { "message": "kitna banana hai aaj", "expect": { "action": "what" } },
    { "message": "how many orders so far", "expect": { "actionIn": ["how", "orders"] } },
    { "message": "who ordered today", "expect": { "action": "orders" } },
    { "message": "give me the message to forward", "expect": { "action": "message" } },
    { "message": "what can you do", "expect": { "action": "help" } },
    { "message": "my daughter's birthday is tomorrow lol", "expect": { "action": "other" } },
    { "message": "add chicken curry", "expect": { "actionIn": ["other", "edit_menu", "set_menu", "add_products"], "noNewPrices": true } }
  ]
