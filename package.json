{
  "name": "preppr",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp ordering assistant for small kitchens: takes orders in chat, totals them, and tells the kitchen what to prep",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --external @electric-sql/pglite",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parser": "RUN_PARSER_EVAL=1 vitest run test/parser.eval.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "import:customers": "tsx scripts/import-customers.ts",
    "import:chat-export": "tsx scripts/import-chat-export.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "author": "",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "0.5.10",
    "@hono/node-server": "^2.1.5",
    "@sentry/node": "^11.9.0",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
